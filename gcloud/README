===================================================
Kubernetes Gateway API for GKE. https://cloud.google.com/kubernetes-engine/docs/how-to/deploying-gateways
===================================================
kubectl -n djmz apply -f https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.0.0/standard-install.yaml
gcloud container clusters update gke-dj-pool --gateway-api=standard --zone us-central1-a
To inspect the contents of your cluster, go to: https://console.cloud.google.com/kubernetes/workload_/gcloud/us-central1-a/gke-dj-pool?project=my-map-project-186104

gcloud container clusters describe gke-dj-pool￼ --zone us-central1-a --format json
kubectl get gatewayclass

kubectl -n djmz get gateway
kubectl -n djmz describe gateway media-gateway
kubectl -n djmz get gateway media-gateway -o=jsonpath="{.status.addresses[0].value}"
34.128.159.129
kubectl -n djmz describe httproute auth-route
kubectl -n djmz get gcpgatewaypolicy

Debugging:  Look for errors.
kubectl -n djmz get gateway media-gateway -o=jsonpath="{.status}" | jq


kubectl -n djmz logs media-f75dd549c-5dhwt

https://kubernetes.io/docs/concepts/services-networking/service/

===================================================
APISIX in GKE. https://apisix.apache.org/docs/ingress-controller/deployments/gke/
===================================================

https://apisix.apache.org/docs/ingress-controller/tutorials/configure-ingress-with-gateway-api/
kubectl create ns ingress-apisix
helm install apisix apisix/apisix --namespace ingress-apisix \
--set dashboard.enabled=true \
--set gateway.type=NodePort \
--set ingress-controller.enabled=true \
--set ingress-controller.config.kubernetes.ingressVersion=networking/v1beta1 \
--set ingress-controller.config.apisix.serviceNamespace=ingress-apisix \
--set ingress-controller.config.kubernetes.enableGatewayAPI=true

  export NODE_PORT=$(kubectl get --namespace ingress-apisix -o jsonpath="{.spec.ports[0].nodePort}" services apisix-gateway)
  export NODE_IP=$(kubectl get nodes --namespace ingress-apisix -o jsonpath="{.items[0].status.addresses[0].address}")
  echo http://$NODE_IP:$NODE_PORT
http://10.45.185.3:32579


kubectl -n djmz run httpbin --image kennethreitz/httpbin --port 80
kubectl -n djmz expose pod httpbin --port 80
