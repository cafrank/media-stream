    kubectl port-forward --namespace keycloak svc/keycloak-db-postgresql-ha-pgpool 5432:5432 &
    psql -h 127.0.0.1 -p 5432 -U postgres -d postgres
    kubectl run keycloak-db-postgresql-ha-client --rm --tty -i --restart='Never' --namespace keycloak --image docker.io/bitnami/postgresql-repmgr:16.1.0-debian-11-r12 --env="PGPASSWORD=$POSTGRES_PASSWORD"  \
        --command -- psql -h keycloak-db-postgresql-ha-pgpool -p 5432 -U postgres -d postgres
kubectl -n keycloak apply -f keycloak.yaml

