Apache APISIX: https://apisix.apache.org/docs/helm-chart/apisix/
================================================================
helm repo add apisix https://charts.apiseven.com
helm repo update
helm install apisix apisix/apisix                     --create-namespace --namespace apisix
helm install apisix-dashboard apisix/apisix-dashboard --create-namespace --namespace apisix
  export POD_NAME=$(kubectl get pods --namespace apisix -l "app.kubernetes.io/name=apisix-dashboard,app.kubernetes.io/instance=apisix-dashboard" -o jsonpath="{.items[0].metadata.name}")
  export CONTAINER_PORT=$(kubectl get pod --namespace apisix $POD_NAME -o jsonpath="{.spec.containers[0].ports[0].containerPort}")
  echo "Visit http://127.0.0.1:8080 to use your application"
  kubectl --namespace apisix port-forward $POD_NAME 8080:$CONTAINER_PORT
  kubectl --namespace apisix port-forward apisix-dashboard-679cf887f-j687r 8080:9000 --address='0.0.0.0'   # Sweet!
  http://api.djmz.com:8000/
  microk8s disable ingress  # Apisix replaces the default ngnix ingress

Need to port forward the apisix pod (apisix-58c6c96bd8-rgndp) for INGRESS INBOUND
  kubectl get pod --namespace apisix apisix-58c6c96bd8-rgndp -o jsonpath="{.spec.containers[0].ports}"
  kubectl get pod --namespace apisix apisix-58c6c96bd8-rgndp -o jsonpath="{.spec.containers[0].ports[0].containerPort}"
  9080
  sudo kubectl --namespace apisix port-forward apisix-58c6c96bd8-rgndp --address='0.0.0.0'  80:9080
  sudo kubectl --namespace apisix port-forward apisix-58c6c96bd8-rgndp --address='0.0.0.0' 443:9443

Pods:
keycloak: k get pod keycloak-0 -o jsonpath="{.spec.containers[0].ports}"
    [{"containerPort":8443,"protocol":"TCP"}]
    k port-forward keycloak-0 --address=0.0.0.0 8443:8443
    https://key.lxci.net:8443

apisix: kubectl get pod --namespace apisix apisix-58c6c96bd8-c7sr9 -o jsonpath="{.spec.containers[0].ports}"
    {"containerPort":9080,"name":"http","protocol":"TCP"},
    {"containerPort":9443,"name":"tls","protocol":"TCP"},
    {"containerPort":9180,"name":"admin","protocol":"TCP"}

# helm uninstall apisix --namespace apisix
# https://apisix.apache.org/docs/ingress-controller/tutorials/manage-ingress-certificates-with-cert-manager/
helm install apisix apisix/apisix \
  --namespace apisix \
  --set gateway.tls.enabled=true \
  --set gateway.type=NodePort \
  --set ingress-controller.enabled=true \
  --set ingress-controller.config.apisix.serviceNamespace=apisix

Use k9s to start a shell on the apisix-58c6c96bd8-c7sr9 pod
apt install net-tools curl
kubectl apply -f https://github.com/cert-manager/cert-manager/releases/download/v1.10.1/cert-manager.yaml
k apply -f cert.yaml

Apache APISIX Dashboaed Create SSL
================================================================
$ openssl pkcs12 -info -in key.lxci.net.p12   # Cert
$ openssl pkcs12 -in key.lxci.net.p12 -nodes -nocerts   # Private key
$ openssl pkcs12 -in key.lxci.net.p12 -nodes -nocerts   # Private key

Apache APISIX INGRESS: https://apisix.apache.org/blog/2022/09/09/kubernetes-ingress-with-apisix/
