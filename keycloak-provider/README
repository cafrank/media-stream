APISIX TLS
========================================================================
kubectl -n apisix exec -it apisix-... -- wget --header="Host: key.lxci.net" https://localhost:9443
kubectl -n apisix exec -it apisix-... -- openssl s_client -host localhost -port 9443 -servername key.lxci.net -verify 1

TLS: https://shocksolution.com/2018/12/14/creating-kubernetes-secrets-using-tls-ssl-as-an-example/
kubectl create secret tls lxci-net-tls --key="/Users/cfrank/git/kc/keycloak-20.0.1/cert/my12ss.key.pem" --cert="/Users/cfrank/git/kc/keycloak-20.0.1/cert/key.lxci.net.crt.pem"
kubectl get    secrets
kubectl delete secret/lxci-net-tls  # Remake in the right namespace
kubectl -n djmz get secret lxci-net-tls -o yaml > k8s-tls-lxci-secret.yaml

