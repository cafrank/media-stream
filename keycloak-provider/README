===========================================
     Kubernetes  Install
===========================================
$ brew install kubectl
$ brew install miniube
$ minikube start
$ eval $(minikube docker-env)   # Connect minikube to local docker repo.

$ cd ~/git/kc/keycloak-20.0.1
$ docker build -t mykeycloak .
$ docker images
$ docker network create keycloak-network
$ docker run -it --name mykeycloak -p 8180:8080 mykeycloak start-dev
$ bin/kc.sh start-dev --http-port 8180 --https-certificate-file=cert/key.lxci.net.crt.pem --https-certificate-key-file=cert/my12ss.key.pem --hostname-url=https://key.lxci.net:8443
$ docker run -it --net keycloak-network --name mykeycloak -p 8443:8443 mykeycloak start-dev \
        --https-certificate-file=cert/key.lxci.net.crt.pem \
        --https-certificate-key-file=cert/my12ss.key.pem   \
        --hostname-url=https://key.lxci.net:8443

