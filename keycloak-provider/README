===========================================
SSL: https://swjm.blog/deploying-keycloak-with-ssl-in-just-10-minutes-46073e5cf699
===========================================
Create cert om mac: certtool c
Export from keychain as Certificate.p12
Convert to pem: https://stackoverflow.com/questions/15144046/converting-pkcs12-certificate-into-pem-using-openssl
$ openssl pkcs12 -in Certificates.p12 -out my12ss.crt.pem -clcerts -nokeys
$ openssl pkcs12 -in Certificates.p12 -out my12ss.key.pem -nocerts -nodes
$ bin/kc.sh start-dev start-dev --http-port 8180 --https-certificate-file=cert/my12ss.crt.pem --https-certificate-key-file=cert/my12ss.key.pem

============================================
Kubernetes TLS secret for Gatewat or Ingres
============================================
openssl pkcs12 -in key.lxci.net.p12 -out lxci.crt.pem - -clcerts -nokeys
openssl pkcs12 -in key.lxci.net.p12 -out lxci.key.pem -nocerts -nodes
kubectl -n djmz create secret tls lxci-net-tls --key="lxci.key.pem" --cert="lxci.crt.pem"
kubectl -n djmz get secret lxci-net-tls -o yaml > k8s-key-lxci.net.yaml


# Docker using p12 cert in server.keystrore
    $ openssl pkcs12 -export -in key_lxci_net.pem -inkey my12ss.key.pem -name ‘keycloak’ -out key.lxci.net.p12
      Passwd: password
    ADD key.lxci.net.p12            conf/server.keystore
    ADD target/org.sparkle-auth.jar providers/cf-provider.jar
    RUN /opt/keycloak/bin/kc.sh build


export JAVA_HOME=`/usr/libexec/java_home`
sudo keytool -importcert -file cert/osafo.crt.pem -alias osafo -keystore \
 /Users/cfrank/Library/Java/JavaVirtualMachines/openjdk-18.0.2/Contents/Home/lib/security/cacerts
# Solve the mismatch issuer by adding -hostname-url
$ bin/kc.sh start-dev --http-port 8180 --https-certificate-file=cert/key.lxci.net.crt.pem --https-certificate-key-file=cert/my12ss.key.pem --hostname-url=https://key.lxci.net:8443

