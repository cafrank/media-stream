# -*- mode: ruby -*-
# vi: set ft=ruby :
# =============================================================================
# Vagrantfile — BorgCloud 3-node k3s cluster
# Provider: VirtualBox   Box: ubuntu/jammy64 (Ubuntu 22.04 LTS)
# VirtualBox group: /BorgCloud   VMs: k3s-node1, k3s-node2, k3s-node3
#
# Prerequisites: Vagrant >= 2.3, VirtualBox 7.x
# Generate cluster SSH key first (make vagrant-up does this for you):
#   ssh-keygen -t ed25519 -f ~/.ssh/cluster_id_rsa -N ''
# Quick start:  make up
# =============================================================================

vars = {}
vars_sh = File.join(__dir__, "vars.sh")
File.readlines(vars_sh).each do |line|
  m = line.match(/^\s*([A-Z0-9_]+)="([^"$]*)"/)
  vars[m[1]] = m[2] if m
end

VBOX_GROUP    = vars.fetch("VBOX_GROUP",    "/BorgCloud")
VM_BOX        = vars.fetch("VM_BOX",        "ubuntu/jammy64")
VM_MEMORY     = ENV.fetch("VM_MEMORY", vars.fetch("VM_MEMORY", "4096")).to_i
VM_CPUS       = ENV.fetch("VM_CPUS",   vars.fetch("VM_CPUS",   "2")).to_i
CLUSTER_IFACE = vars.fetch("CLUSTER_IFACE", "enp0s8")

ssh_key_pub = File.expand_path("~/.ssh/cluster_id_rsa.pub")
CLUSTER_PUB_KEY = File.exist?(ssh_key_pub) ? File.read(ssh_key_pub).strip : ""

NODES = (1..3).map do |i|
  { name: vars.fetch("NODE#{i}_NAME", "k3s-node#{i}"),
    ip:   vars.fetch("NODE#{i}_IP",   "192.168.56.#{120 + i}") }
end.freeze

HOSTS_ENTRIES = NODES.map { |n| "#{n[:ip]} #{n[:name]}" }.join("\n")

Vagrant.configure("2") do |config|
  config.vm.box              = VM_BOX
  config.vm.box_check_update = false
  config.ssh.insert_key      = false

  NODES.each do |node|
    nname   = node[:name]
    nip     = node[:ip]
    pub_key = CLUSTER_PUB_KEY

    config.vm.define nname do |m|
      m.vm.hostname = nname

      # NIC2: Host-Only cluster network 192.168.56.x
      m.vm.network "private_network", ip: nip, netmask: "255.255.255.0"

      m.vm.provider "virtualbox" do |vb|
        vb.name   = nname
        vb.memory = VM_MEMORY
        vb.cpus   = VM_CPUS
        vb.gui    = false
        vb.customize ["modifyvm", :id, "--groups", VBOX_GROUP]
        # Intel PRO/1000 MT (82540EM), not virtio: VirtualBox's virtio-net stalled a
        # node's host-only NIC ("Unexpected TXQ (0) queue failure: -5"), cutting it off.
        (1..2).each { |n| vb.customize ["modifyvm", :id, "--nictype#{n}", "82540EM"] }
      end

      m.vm.provision "shell", name: "hosts-and-ssh", inline: <<~SHELL
        set -euo pipefail

        # Resolve cluster peers by name; drop the 127.0.1.1 self-mapping so
        # k3s picks the host-only IP rather than loopback.
        sed -i '/^127\\.0\\.1\\.1/d' /etc/hosts
        sed -i '/k3s-node[0-9]/d' /etc/hosts
        cat >> /etc/hosts << 'HOSTS'
        #{HOSTS_ENTRIES}
        HOSTS

        mkdir -p /home/ubuntu/.ssh
        chmod 700 /home/ubuntu/.ssh
        if [ -n '#{pub_key}' ]; then
          grep -qxF '#{pub_key}' /home/ubuntu/.ssh/authorized_keys 2>/dev/null \
            || echo '#{pub_key}' >> /home/ubuntu/.ssh/authorized_keys
          chmod 600 /home/ubuntu/.ssh/authorized_keys
          chown -R ubuntu:ubuntu /home/ubuntu/.ssh
          echo "  Cluster SSH key installed."
        else
          echo "  WARN: No cluster key. Run: ssh-keygen -t ed25519 -f ~/.ssh/cluster_id_rsa -N ''"
        fi

        echo "  Provisioned: $(hostname -s)  cluster=#{nip} (#{CLUSTER_IFACE})"
      SHELL
    end
  end
end
