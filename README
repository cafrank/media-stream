[root@c1 ~]# su - postgres
for i in ARTIST_ID AUDIO_OLDSCHOOL CRATE DJMZ_AUDIO DJMZ_VIDEO DJTOOLS FREE RMX_VIDEO VIDEO VIDEO_SAMPLES VJTOOLS
     psql -t -c "SELECT array_to_json(array_agg(t)) FROM (SELECT song_id AS songId, title, artist, genre, equalizer AS remix, label, comments AS comment, bpm, year, comments as coverUrl, vms_repo_path AS file FROM vms_songs WHERE vms_repo='$i' AND song_id BETWEEN 0 AND 100000) t;" > /tmp/data-$i-000k-100k.json;

LAST_BATCH=0
LAST_BATCH=6488
for i in ARTIST_ID AUDIO_OLDSCHOOL CRATE DJMZ_AUDIO DJTOOLS FREE;
for i in CRATE ;
do
     psql -t -c "SELECT 'test -f /var/www/html/prev/gen3/' || song_id || '.mp3 || ln -s /mnt/disk1/void/music/\"' || vms_repo_path || '\" /var/www/html/prev/gen3/' || song_id || '.mp3' FROM vms_songs WHERE vms_repo='$i' AND batch_id > $LAST_BATCH;" > /tmp/ln-$i.sh;
done
     psql -t -c "SELECT array_to_json(array_agg(t)) FROM (SELECT song_id, title, artist, genre, equalizer AS remix, label, comments AS comment, bpm, year, false AS is_video, comments as coverUrl, vms_repo_path AS file FROM vms_songs WHERE vms_repo='$i' AND batch_id > $LAST_BATCH) t;" > /tmp/data-$i.json;

for i in DJMZ_VIDEO RMX_VIDEO VIDEO VIDEO_SAMPLES VJTOOLS;
do
     psql -t -c "SELECT array_to_json(array_agg(t)) FROM (SELECT song_id, title, artist, genre, equalizer AS remix, label, comments AS comment, bpm, year, true AS is_video, comments as coverUrl, vms_repo_path AS file FROM vms_songs WHERE vms_repo='$i' AND batch_id > $LAST_BATCH) t;" > /tmp/data-$i.json;
     psql -t -c "SELECT 'test -f /var/www/html/prev/gen3/' || song_id || '.mp4 || ln -s /mnt/disk2/void/video/\"' || vms_repo_path || '\" /var/www/html/prev/gen3/' || song_id || '.mp4' FROM vms_songs WHERE vms_repo='$i' AND batch_id > $LAST_BATCH;" > /tmp/ln-$i.sh;
     psql -t -c "SELECT 'test -f /var/www/html/prev/gen3/' || song_id || '.mp4 || ln -s /mnt/disk1/void/music/\"' || vms_repo_path || '\" /var/www/html/prev/gen3/' || song_id || '.mp3' FROM vms_songs WHERE vms_repo='$i' AND batch_id > $LAST_BATCH;" > /tmp/ln-$i.sh;
done
LAST_BATCH=`psql -t -c "SELECT MAX(batch_id) FROM vms_songs;"`

for i in /tmp/ln-*.sh
do
    sh $i
done

for i in

     ARTIST_ID AUDIO_OLDSCHOOL CRATE DJMZ_AUDIO DJTOOLS FREE;
for i in VIDEO ;
do
    echo "====== $i =======";
    curl -X POST -H "Content-Type: application/json" -d @<(ssh root@169.45.92.99 cat /tmp/data-$i.json) http://localhost:8084/api/media/bulk
done

